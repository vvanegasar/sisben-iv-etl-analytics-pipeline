# Copy this file to .env and fill in your own locations. .env is git-ignored.
# Every setting can also be passed as a command-line flag (run any script with --help).
# Empty values fall back to the defaults described below. Never commit real paths or data.

# Local output folder (Parquet, CSV, logs). Default: out/ at the repository root.
SISBEN_OUTPUT_DIR=

# --- Main ETL: src/etl/etl_sisben_definitivo.py --------------------------------
# Master Parquet with the SISBEN IV microdata (required).
SISBEN_PARQUET_IN=
# Enriched output. Default: <SISBEN_OUTPUT_DIR>/sisben_master_final.parquet
SISBEN_PARQUET_OUT=
# Per-municipality partitioned CSVs. Default: <SISBEN_OUTPUT_DIR>/csvs_sisben_ultimo_anio
SISBEN_CSV_DIR=
# Rows per batch. Default: 150000
SISBEN_CHUNK_ROWS=

# --- Reference data (defaults point to the public files in data/) -------------
SISBEN_DIVIPOLA_CSV=
SISBEN_DANE_HOGARES_XLSX=
SISBEN_DANE_VIVIENDAS_XLSX=

# --- Projections: src/etl/etl_poblacion_cobertura.py and etl_dane_viviendas_hogares.py
# Population projections CSV (required by etl_poblacion_cobertura.py).
# Expected columns: DPMP, AÑO, Genero, ÁREA GEOGRÁFICA, EDAD_NUM, Pob
SISBEN_POBLACION_CSV=
# Outputs. Defaults: <SISBEN_OUTPUT_DIR>/poblacion_proyectada.parquet, hogares_dane.parquet, viviendas_dane.parquet
# SISBEN_POBLACION_PARQUET is also read by model/master_audit_fixed.ps1.
SISBEN_POBLACION_PARQUET=
SISBEN_HOGARES_PARQUET=
SISBEN_VIVIENDAS_PARQUET=

# --- Optional publishing step --------------------------------------------------
# The per-municipality CSVs contain person-level records (Colombian Law 1581 of 2012).
# Publish them only to an access-controlled location defined by the data controller.
# Local root of the publishing folder. Default: <SISBEN_OUTPUT_DIR>/publicacion_local
SISBEN_PUBLISH_DIR=
# Base URL of that folder. Empty: the downloads dimension stores relative paths.
SISBEN_PUBLISH_BASE_URL=
# Optional suffix appended to every download URL.
SISBEN_PUBLISH_URL_SUFFIX=
# Downloads dimension. Default: <SISBEN_OUTPUT_DIR>/dim_descargas_municipios.csv
SISBEN_DIM_CSV=
# Optional image URL template, e.g. https://<your-server>/flags/{cod_mpio}.png
# Use only images whose license allows reuse, and credit their source.
SISBEN_FLAG_URL_TEMPLATE=

# --- Optional resources copied by src/etl/upload_recursos.py -------------------
SISBEN_DICTIONARY_PATH=
SISBEN_INFORMES_DIR=

# --- Data-quality utilities ----------------------------------------------------
# Default: model/tmdl_sisben/tables
SISBEN_TMDL_TABLES_DIR=
SISBEN_REINFORCE_IN=
SISBEN_REINFORCE_OUT=
